# Copy to .env and replace local credentials before starting Compose.
# Keep this file free of real passwords, tokens, and private keys.

# Docker Compose / local development
SPRING_PROFILES_ACTIVE=develop
TAKEOUT_DB_USERNAME=root
TAKEOUT_DB_PASSWORD=replace-with-a-strong-local-password
TAKEOUT_DB_HOST=localhost
TAKEOUT_DB_PORT=3310
TAKEOUT_JWT_SECRET=replace-with-at-least-32-random-bytes
TAKEOUT_MYSQL_PORT=3310
TAKEOUT_REDIS_PORT=6387
TAKEOUT_APP_PORT=8087
TAKEOUT_DEMO_RECHARGE_ENABLED=true
TAKEOUT_SMS_EXPOSE_MOCK_CODE=true
TAKEOUT_PAYMENT_REAL_ENABLED=false
TAKEOUT_PAYMENT_MOCK_ENABLED=true
TAKEOUT_PAYMENT_SANDBOX=true

# Alipay sandbox defaults; add credentials only when configuring sandbox payments.
TAKEOUT_ALIPAY_APP_ID=9021000169644800
TAKEOUT_ALIPAY_SELLER_ID=2088721115957570
TAKEOUT_ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
TAKEOUT_ALIPAY_APP_PRIVATE_KEY=
TAKEOUT_ALIPAY_PUBLIC_KEY=
TAKEOUT_ALIPAY_NOTIFY_URL=

# Production-only examples. Populate only when SPRING_PROFILES_ACTIVE=production.
# TAKEOUT_PAYMENT_REAL_ENABLED=true
# TAKEOUT_PAYMENT_MOCK_ENABLED=false
# TAKEOUT_PAYMENT_SANDBOX=false
