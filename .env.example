# Copy to .env and replace local credentials before starting Compose.
# Keep this file free of real passwords, tokens, and private keys.

# Docker Compose / local development
SPRING_PROFILES_ACTIVE=develop
TAKEOUT_DB_USERNAME=takeout
TAKEOUT_MYSQL_ROOT_PASSWORD=
TAKEOUT_DB_PASSWORD=replace-with-a-strong-local-password
TAKEOUT_DB_HOST=localhost
TAKEOUT_DB_PORT=3310
# Generate six independent values: openssl rand -base64 32
TAKEOUT_JWT_SECRET=
TAKEOUT_VERIFICATION_HMAC_SECRET=
TAKEOUT_ASSISTANT_ENCRYPTION_SECRET=
TAKEOUT_WALLET_ENCRYPTION_SECRET=
TAKEOUT_PERSONAL_DATA_ENCRYPTION_SECRET=
TAKEOUT_PERSONAL_DATA_INDEX_SECRET=
# Comma-separated previous personal-data encryption secrets for a controlled key rotation.
TAKEOUT_PERSONAL_DATA_PREVIOUS_ENCRYPTION_SECRETS=
TAKEOUT_REDIS_PASSWORD=
# Shared Redis also holds security state: keep noeviction. Container memory limit is 768M.
TAKEOUT_REDIS_MAXMEMORY=256mb
TAKEOUT_REDIS_MAXMEMORY_POLICY=noeviction
# Eight fixed catalog entries only; dynamic entries retain the 64KiB ceiling.
TAKEOUT_CACHE_MAX_ENTRY_BYTES=1048576
TAKEOUT_MYSQL_PORT=3310
TAKEOUT_REDIS_PORT=6387
# Actuator uses a separate loopback listener; never publish these ports through the business proxy.
# Defaults: app 9101, ERP 9201, Gateway 8088. Monitoring overlay exposes them only inside Compose.
TAKEOUT_MANAGEMENT_ADDRESS=127.0.0.1
# Optional monitoring overlay only; use an independent administrator password.
TAKEOUT_GRAFANA_PASSWORD=
TAKEOUT_APP_PORT=8087
# Stable worker IDs, unique across every concurrently running ID-producing process (0..1023).
# Assign another unused value to each replica; never clone a worker ID into another live process.
TAKEOUT_APP_SNOWFLAKE_WORKER_ID=0
TAKEOUT_APP_SECONDARY_SNOWFLAKE_WORKER_ID=2
TAKEOUT_ERP_SNOWFLAKE_WORKER_ID=1
# Direct java/Maven startup: export the selected service's value as TAKEOUT_SNOWFLAKE_WORKER_ID.
# Login CPU cost is about 95ms per 600k PBKDF2 on the measured host, including missing accounts.
# Raising attempt limits or shortening failure blocks increases CPU exposure. Keep the verification cap.
TAKEOUT_LOGIN_FAILURE_LIMIT=10
TAKEOUT_LOGIN_FAILURE_WINDOW_SECONDS=60
TAKEOUT_LOGIN_FAILURE_BLOCK_SECONDS=600
TAKEOUT_LOGIN_TOTAL_LIMIT=60
TAKEOUT_LOGIN_TOTAL_WINDOW_SECONDS=60
TAKEOUT_LOGIN_TOTAL_BLOCK_SECONDS=60
# Account failure only; successful logins do not consume this budget.
TAKEOUT_LOGIN_ACCOUNT_LIMIT=10
TAKEOUT_LOGIN_ACCOUNT_WINDOW_SECONDS=60
TAKEOUT_LOGIN_ACCOUNT_BLOCK_SECONDS=600
TAKEOUT_LOGIN_ACCOUNT_TOTAL_LIMIT=30
TAKEOUT_LOGIN_ACCOUNT_TOTAL_WINDOW_SECONDS=60
TAKEOUT_LOGIN_ACCOUNT_TOTAL_BLOCK_SECONDS=60
# Per app process, not per IP. Startup accepts concurrency 1..16 and wait 0..10000ms.
TAKEOUT_LOGIN_VERIFY_MAX_CONCURRENT=2
TAKEOUT_LOGIN_VERIFY_WAIT_MILLIS=5000
# 高德：REST Key 仅供后端代理使用；JS Key 供客户端地图 WebView 使用
TAKEOUT_AMAP_REST_KEY=
TAKEOUT_AMAP_JS_KEY=
TAKEOUT_AMAP_SECURITY_CODE=
TAKEOUT_DEMO_RECHARGE_ENABLED=false
TAKEOUT_DEMO_SIGNUP_BALANCE=0
TAKEOUT_DATA_SEED_ENABLED=false
TAKEOUT_DEMO_ADMIN_PASSWORD=
TAKEOUT_SMS_EXPOSE_MOCK_CODE=false
TAKEOUT_SMS_PROVIDER=qq-email
TAKEOUT_SMS_CODE_TTL_SECONDS=900
TAKEOUT_SMS_COOLDOWN_SECONDS=60
TAKEOUT_SMS_DAILY_LIMIT=5
TAKEOUT_SMS_HOURLY_LIMIT=100
TAKEOUT_QQ_SMTP_HOST=smtp.qq.com
TAKEOUT_QQ_SMTP_PORT=465
TAKEOUT_QQ_SMTP_USERNAME=
TAKEOUT_QQ_SMTP_AUTH_CODE=
TAKEOUT_QQ_SMTP_FROM_NAME=简单外卖
TAKEOUT_PAYMENT_REAL_ENABLED=false
TAKEOUT_PAYMENT_MOCK_ENABLED=false
TAKEOUT_PAYMENT_SANDBOX=true

# Alipay sandbox and balance are the supported payment methods for this experience environment.
TAKEOUT_ALIPAY_APP_ID=9021000169644800
TAKEOUT_ALIPAY_SELLER_ID=2088721115957570
TAKEOUT_ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
TAKEOUT_ALIPAY_APP_PRIVATE_KEY=
TAKEOUT_ALIPAY_PUBLIC_KEY=
TAKEOUT_ALIPAY_NOTIFY_URL=

# Production-only examples. Populate only when SPRING_PROFILES_ACTIVE=production.
# TAKEOUT_PAYMENT_REAL_ENABLED=true
# TAKEOUT_PAYMENT_MOCK_ENABLED=false
# TAKEOUT_PAYMENT_SANDBOX=false
# TAKEOUT_SMS_PROVIDER=qq-email
# TAKEOUT_SMS_EXPOSE_MOCK_CODE=false
# TAKEOUT_QQ_SMTP_HOST=smtp.qq.com
# TAKEOUT_QQ_SMTP_PORT=465
# TAKEOUT_QQ_SMTP_USERNAME=your-qq-number@qq.com
# TAKEOUT_QQ_SMTP_AUTH_CODE=qq-mail-authorization-code
# HUAWEI_SMS_ENDPOINT=
# HUAWEI_SMS_APP_KEY=
# HUAWEI_SMS_APP_SECRET=
# HUAWEI_SMS_SENDER=
# HUAWEI_SMS_SIGNATURE=
# HUAWEI_SMS_TEMPLATE_ID=
# HUAWEI_OBS_ENDPOINT=
# HUAWEI_OBS_BUCKET=
# HUAWEI_OBS_ACCESS_KEY=
# HUAWEI_OBS_SECRET_KEY=
# HUAWEI_OBS_PUBLIC_BASE_URL=
# TAKEOUT_ALIPAY_APP_ID=
# TAKEOUT_ALIPAY_SELLER_ID=
# TAKEOUT_ALIPAY_APP_PRIVATE_KEY=
# TAKEOUT_ALIPAY_PUBLIC_KEY=
# TAKEOUT_ALIPAY_NOTIFY_URL=https://your-domain.example/api/payment/alipay/notify

# Independent ERP database and internal service authentication (required by Compose).
# Generate each credential independently. Never reuse JWT / wallet / database root keys.
TAKEOUT_ERP_MYSQL_ROOT_PASSWORD=
TAKEOUT_ERP_DB_PASSWORD=
TAKEOUT_INTEGRATION_SECRET=
# For native runs: provision takeout_erp and grant its user privileges ONLY on that schema.
# TAKEOUT_ERP_DB_URL=jdbc:mysql://localhost:3310/takeout_erp?useSSL=false&serverTimezone=Asia/Shanghai
# TAKEOUT_ERP_DB_USERNAME=takeout_erp
# TAKEOUT_ERP_ENABLED=true
# TAKEOUT_ERP_URI=http://127.0.0.1:9200
# TAKEOUT_APP_URI=http://127.0.0.1:9100
