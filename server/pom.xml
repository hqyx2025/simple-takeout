<?xml version="1.0" encoding="UTF-8"?>
<!--
  简单外卖后端 · Maven 聚合根。

  设计取舍：聚合 POM 用 <modules> 聚合各服务，**且不设 packaging=jar 之外的构建**，
  目的是让 `mvn -f server/pom.xml test` 这条既有命令**继续有效**——它会自动跑到所有
  子模块的测试（现有 221 个用例全部保留在 takeout-app 中），无需改成 `-pl takeout-app`。
  只有 `spring-boot:run` 这类需要指定单一应用的命令才需要 `-pl takeout-app`。

  为什么保留 server/pom.xml 这个路径而不是挪到别处：AGENTS.md、README、Dockerfile、
  docker-compose 与各脚本都引用它；路径不变 = 零外部改动。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>takeout-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>simple-takeout-server</name>
  <description>简单外卖后端：Maven 聚合根（单体过渡承载 + 微服务拆分）</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <!-- Security fixes released after the Spring Boot 3.5 BOM baseline. -->
    <tomcat.version>11.0.27</tomcat.version>
    <netty.version>4.2.19.Final</netty.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
    <log4j2.version>2.26.1</log4j2.version>
    <commons-lang3.version>3.21.0</commons-lang3.version>
    <bouncycastle.version>1.86</bouncycastle.version>
  </properties>

  <modules>
    <module>takeout-common</module>
    <module>takeout-app</module>
    <module>takeout-gateway</module>
    <module>takeout-erp</module>
    <module>takeout-coverage</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>coverage-report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Reserved for isolated test JVMs; runtime nodes must configure their own worker ID. -->
          <environmentVariables>
            <TAKEOUT_SNOWFLAKE_WORKER_ID>1023</TAKEOUT_SNOWFLAKE_WORKER_ID>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <!-- Keep the Spring Cloud 2025.0 line compatible with Spring Boot 3.5. -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>ognl</groupId>
        <artifactId>ognl</artifactId>
        <version>3.4.16</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
