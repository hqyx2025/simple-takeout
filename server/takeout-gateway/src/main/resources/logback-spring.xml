<?xml version="1.0" encoding="UTF-8"?>
<!-- 网关日志：与应用统一输出到 TAKEOUT_LOG_DIR，并按天/大小轮转。 -->
<configuration>
    <property name="LOG_DIR" value="${TAKEOUT_LOG_DIR:-logs}"/>
    <property name="LOG_LEVEL" value="${TAKEOUT_LOG_LEVEL:-INFO}"/>
    <property name="ROOT_LEVEL" value="${TAKEOUT_LOG_ROOT_LEVEL:-INFO}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/gateway.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/gateway-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxFileSize>2MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="org.springframework.cloud.gateway" level="${LOG_LEVEL}"/>
    <logger name="org.springframework.web" level="WARN"/>
    <root level="${ROOT_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
